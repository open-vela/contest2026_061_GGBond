      lian: ['帘'],
      liang: ['亮'],
      ling: ['铃'],
      lu: ['炉', '路'],
      luyou: ['路由'],
      men: ['门'],
      mian: ['面'],
      mi: ['米'],
      nao: ['脑'],
      pai: ['排'],
      pan: ['盘'],
      ping: ['平'],
      qi: ['器'],
      qian: ['前'],
      qiang: ['墙'],
      qing: ['清'],
      qu: ['区'],
      re: ['热'],
      ren: ['人'],
      ri: ['日'],
      rou: ['柔'],
      ru: ['入'],
      sao: ['扫'],
      sha: ['沙'],
      shan: ['扇'],
      shang: ['上'],
      she: ['摄'],
      shen: ['身'],
      sheng: ['声'],
      shi: ['湿', '室'],
      shou: ['手'],
      shu: ['书'],
      shui: ['水'],
      si: ['四'],
      suo: ['锁'],
      tai: ['台'],
      tao: ['套'],
      ti: ['体'],
      tian: ['添'],
      ting: ['厅'],
      tou: ['头'],
      tu: ['图'],
      tuo: ['拖'],
      wan: ['碗'],
      wei: ['微', '卫'],
      wen: ['温'],
      wo: ['卧'],
      xi: ['洗'],
      xian: ['线'],
      xiang: ['箱', '像'],
      xiao: ['小'],
      xing: ['星'],
      ya: ['压'],
      yan: ['烟'],
      yang: ['阳'],
      yao: ['遥'],
      yi: ['椅', '衣', '仪'],
      yin: ['音', '饮'],
      you: ['油', '右'],
      yu: ['浴'],
      yuan: ['源'],
      zai: ['在'],
      zao: ['灶'],
      zhi: ['智'],
      zhong: ['中'],
      zhu: ['主'],
      zhuo: ['桌'],
      zi: ['子'],
      zou: ['走'],
      zuo: ['左']
    }
  },

  addUniqueImeCandidate(result, item) {
    if (!item || !item.text) {
      return
    }
    for (let index = 0; index < result.length; index++) {
      if (result[index].text === item.text) {
        return
      }
    }
    result.push(item)
  },

  buildPinyinText(key) {
    const map = this.pinyinSyllableMap()
    const syllables = []
    let cursor = 0
    while (cursor < key.length) {
      let found = ''
      const maxLen = key.length - cursor > 6 ? 6 : key.length - cursor
      for (let size = maxLen; size > 0; size--) {
        const part = key.substring(cursor, cursor + size)
        if (map[part]) {
          found = part
          break
        }
      }
      if (!found) {
        return ''
      }
      syllables.push(found)
      cursor += found.length
    }
    let text = ''
    for (let index = 0; index < syllables.length; index++) {
      const words = map[syllables[index]]
      text += words && words[0] ? words[0] : ''
    }
    return text
  },

  currentManualValue() {
    if (this.manualFieldIndex === 0) {
      return this.manualDeviceName
    }
    if (this.manualFieldIndex === 1) {
      return this.manualDeviceType
    }
    return this.manualDeviceZone
  },

  setCurrentManualValue(value) {
    if (this.manualFieldIndex === 0) {
      this.manualDeviceName = value
    } else if (this.manualFieldIndex === 1) {
      this.manualDeviceType = value
    } else {
      this.manualDeviceZone = value
    }
    this.refreshManualInput()
  },

  imeMatches() {
    if (this.pcImeCandidates && this.pcImeCandidates.length > 0) {
      return this.pcImeCandidates
    }
    let dict = this.currentImeDictionary()
    if (this.manualFieldIndex !== 1) {
      dict = dict.concat(this.commonPinyinWords())
    }
    const key = (this.manualImeBuffer || '').toLowerCase()
    const result = []
    for (let index = 0; index < dict.length; index++) {
      const item = dict[index]
      const search = (item.pinyin || '') + ' ' + (item.text || '')
      if (!key || search.toLowerCase().indexOf(key) >= 0) {
        this.addUniqueImeCandidate(result, item)
      }
    }
    if (key && result.length < 4 && this.manualFieldIndex !== 1) {
      const builtText = this.buildPinyinText(key)
      if (builtText) {
        this.addUniqueImeCandidate(result, {
          text: builtText,
          value: builtText,
          pinyin: key,
          type: this.guessManualTypeFromPinyin(key),
          zone: this.manualDeviceZone || '未分区'
        })
      }
    }
    if (key && result.length < 4 && this.manualFieldIndex === 0) {
      this.addUniqueImeCandidate(result, { text: key, value: key, pinyin: key, type: this.guessManualTypeFromPinyin(key), zone: this.manualDeviceZone || '未分区' })
    }
    if (key && result.length < 4 && this.manualFieldIndex === 2) {
      this.addUniqueImeCandidate(result, { text: key, value: key, pinyin: key })
    }
    return result
  },

  updateImeCandidates() {
    const matches = this.imeMatches()
    const pageSize = 3
    const totalPages = Math.max(1, Math.ceil(matches.length / pageSize))
    if (!this.candidatePageIndex || this.candidatePageIndex < 0) {
      this.candidatePageIndex = 0
    }
    if (this.candidatePageIndex >= totalPages) {
      this.candidatePageIndex = totalPages - 1
    }
    const start = this.candidatePageIndex * pageSize
    this.imeBufferText = this.manualImeBuffer || '输入拼音'
    this.candidateText1 = matches[start] ? matches[start].text : (this.manualImeBuffer || '手机')
    this.candidateText2 = matches[start + 1] ? matches[start + 1].text : ''
    this.candidateText3 = matches[start + 2] ? matches[start + 2].text : ''
    this.candidateText4 = ''
  },

  prevCandidatePage() {
    const matches = this.imeMatches()
    const totalPages = Math.max(1, Math.ceil(matches.length / 3))
    this.candidatePageIndex = (this.candidatePageIndex || 0) - 1
    if (this.candidatePageIndex < 0) {
      this.candidatePageIndex = totalPages - 1
    }
    this.updateImeCandidates()
  },

  nextCandidatePage() {
    const matches = this.imeMatches()
    const totalPages = Math.max(1, Math.ceil(matches.length / 3))
    this.candidatePageIndex = (this.candidatePageIndex || 0) + 1
    if (this.candidatePageIndex >= totalPages) {
      this.candidatePageIndex = 0
    }
    this.updateImeCandidates()
  },

  fetchPcImeCandidates() {
    const key = (this.manualImeBuffer || '').toLowerCase()
    if (!key || this.manualFieldIndex === 1) {
      this.pcImeCandidates = []
      this.pcImeRequestKey = key
      this.updateImeCandidates()
      return
    }
    const token = (this.pcImeRequestToken || 0) + 1
    this.pcImeRequestToken = token
    this.pcImeRequestKey = key
    fetch.fetch({
      url: this.pcUrl.replace('/aiot-command', '/pinyin-candidates') + '?text=' + key + '&field=' + this.manualFieldIndex,
      method: 'GET',
      responseType: 'json',
      success: (res) => {
        if (token !== this.pcImeRequestToken || key !== this.manualImeBuffer) {
          return
        }
        const data = res && res.data ? res.data : {}
        const list = data.candidates || []
        const result = []
        for (let index = 0; index < list.length && result.length < 32; index++) {
          const item = list[index]
          const text = item.text || item.value || ''
          if (text) {
            result.push({
              text: text,
              value: item.value || text,
              pinyin: key,
              type: this.guessManualTypeFromPinyin(key),
              zone: this.manualDeviceZone || '未分区'
            })
          }
        }
        if (result.length > 0) {
          this.pcImeCandidates = result
          this.candidatePageIndex = 0
          this.updateImeCandidates()
        }
      },
      fail: () => {
        this.pcImeCandidates = []
        this.updateImeCandidates()
      }
    })
  },

  guessManualTypeFromPinyin(key) {
    if (key.indexOf('deng') >= 0 || key.indexOf('light') >= 0) {
      return 'light'
    }
    if (key.indexOf('xiang') >= 0 || key.indexOf('fridge') >= 0) {
      return 'fridge'
    }
    if (key.indexOf('shexiang') >= 0 || key.indexOf('camera') >= 0) {
      return 'camera'
    }
    if (key.indexOf('kongtiao') >= 0 || key === 'ac') {
      return 'ac'
    }
    if (key.indexOf('tv') >= 0 || key.indexOf('dianshi') >= 0) {
      return 'tv'
    }
    return this.manualDeviceType || 'switch'
  },

  inputImeLetter(letter) {
    this.resetManualCursorBlink()
    this.manualImeBuffer = (this.manualImeBuffer || '') + letter
    this.candidatePageIndex = 0
    this.pcImeCandidates = []
    this.updateImeCandidates()
    this.fetchPcImeCandidates()
  },

  chooseCandidate(index) {
    const matches = this.imeMatches()
    const actualIndex = (this.candidatePageIndex || 0) * 3 + index
    let item = matches[actualIndex]
    if (!item && index === 0 && this.manualImeBuffer) {
      item = { text: this.manualImeBuffer, value: this.manualImeBuffer, pinyin: this.manualImeBuffer }
    }
    if (!item || !item.text) {
      return
    }
    this.setCurrentManualValue(item.value || item.text)
    if (this.manualFieldIndex === 0) {
      if (item.type) {
        this.manualDeviceType = item.type
      }
      if (item.zone) {
        this.manualDeviceZone = item.zone
      }
    }
    this.manualImeBuffer = ''
    this.candidatePageIndex = 0
    this.pcImeCandidates = []
    this.refreshManualInput()
    this.resetManualCursorBlink()
  },

  chooseCandidateOne() { this.chooseCandidate(0) },
  chooseCandidateTwo() { this.chooseCandidate(1) },
  chooseCandidateThree() { this.chooseCandidate(2) },
  chooseCandidateFour() { this.chooseCandidate(3) },

  qKeyQ() { this.inputImeLetter('q') },
  qKeyW() { this.inputImeLetter('w') },
  qKeyE() { this.inputImeLetter('e') },
  qKeyR() { this.inputImeLetter('r') },
  qKeyT() { this.inputImeLetter('t') },
  qKeyY() { this.inputImeLetter('y') },
  qKeyU() { this.inputImeLetter('u') },
  qKeyI() { this.inputImeLetter('i') },
  qKeyO() { this.inputImeLetter('o') },
  qKeyP() { this.inputImeLetter('p') },
  qKeyA() { this.inputImeLetter('a') },
  qKeyS() { this.inputImeLetter('s') },
  qKeyD() { this.inputImeLetter('d') },
  qKeyF() { this.inputImeLetter('f') },
  qKeyG() { this.inputImeLetter('g') },
  qKeyH() { this.inputImeLetter('h') },
  qKeyJ() { this.inputImeLetter('j') },
  qKeyK() { this.inputImeLetter('k') },
  qKeyL() { this.inputImeLetter('l') },
  qKeyZ() { this.inputImeLetter('z') },
  qKeyX() { this.inputImeLetter('x') },
  qKeyC() { this.inputImeLetter('c') },
  qKeyV() { this.inputImeLetter('v') },
  qKeyB() { this.inputImeLetter('b') },
  qKeyN() { this.inputImeLetter('n') },
  qKeyM() { this.inputImeLetter('m') },

  qKeySpace() {
    if (this.manualImeBuffer) {
      this.chooseCandidate(0)
    }
  },

  keyClearInput() {
    this.resetManualCursorBlink()
    this.manualImeBuffer = ''
    this.candidatePageIndex = 0
    this.pcImeCandidates = []
    this.setCurrentManualValue('')
    this.updateImeCandidates()
  },

  keyBack() {
    this.resetManualCursorBlink()
    if (this.manualImeBuffer && this.manualImeBuffer.length > 0) {
      this.manualImeBuffer = this.manualImeBuffer.substring(0, this.manualImeBuffer.length - 1)
      this.candidatePageIndex = 0
      this.pcImeCandidates = []
      this.updateImeCandidates()
      this.fetchPcImeCandidates()
    } else {
      const value = this.currentManualValue() || ''
      if (value.length > 0) {
        this.setCurrentManualValue(value.substring(0, value.length - 1))
      }
    }
  },

  manualNextField() {
    this.resetManualCursorBlink()
    this.manualFieldIndex = (this.manualFieldIndex + 1) % 3
    this.manualImeBuffer = ''
    this.candidatePageIndex = 0
    this.pcImeCandidates = []
    this.refreshManualInput()
    this.resetManualCursorBlink()
  },

  quickNamePhone() {
    this.manualDeviceName = '手机'
    this.manualDeviceType = 'phone'
    this.manualDeviceZone = '随身'
    this.refreshManualInput()
  },

  quickNameFridge() {
    this.manualDeviceName = '冰箱'
    this.manualDeviceType = 'fridge'
    this.manualDeviceZone = '厨房'
    this.refreshManualInput()
  },

  quickNameCamera() {
    this.manualDeviceName = '摄像头'
    this.manualDeviceType = 'camera'
    this.manualDeviceZone = '门口'
    this.refreshManualInput()
  },

  quickZoneDesk() {
    this.manualDeviceZone = '桌面'
    this.manualFieldIndex = 2
    this.refreshManualInput()
  },

  makeManualDeviceId(name) {
    let ascii = ''
    for (let index = 0; index < name.length; index++) {
      const ch = name.charAt(index)
      if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9')) {
        ascii += ch.toLowerCase()
      }
    }
    if (ascii) {
      return ascii
    }
    return 'watch_dev_' + (this.devices.length + 1)
  },

  saveManualDevice() {
    const name = this.manualDeviceName || ''
    const deviceType = this.manualDeviceType || 'switch'
    const zone = this.manualDeviceZone || '未分区'
    if (!name) {
      this.managementMessage = '设备名称不能为空'
      this.showSection('manage')
      return
    }
    const deviceId = this.makeManualDeviceId(name)
    let foundIndex = -1
    for (let index = 0; index < this.devices.length; index++) {
      if (this.devices[index].id === deviceId || this.devices[index].name === name) {
        foundIndex = index
      }
    }
    const device = { id: deviceId, name: name, type: deviceType, zone: zone }
    if (foundIndex >= 0) {
      this.devices[foundIndex] = device
      this.deviceIndex = foundIndex
      this.managementMessage = '已更新设备：' + name
    } else {
      this.devices.push(device)
      this.deviceIndex = this.devices.length - 1
      this.managementMessage = '已手动添加：' + name
    }
    this.ensureRuntimeStates()
    this.syncCurrentDevice()
    this.updateLearningSelection()
    this.sendWatchConfig('manual_add_device', this.managementMessage)
    this.actionConfigMessage = '已添加设备：' + name + '，请继续绑定动作'
    this.openActionConfig()
  },

  localDeleteDevice() {
    if (this.devices.length <= 1) {
      this.managementMessage = '至少保留一个设备'
      return
    }
    const removedId = this.currentDeviceId
    const removedName = this.currentDeviceName
    this.devices.splice(this.deviceIndex, 1)
    const remainingActions = []
    for (let index = 0; index < this.actions.length; index++) {
      const actionDeviceId = this.actions[index].deviceId || this.actions[index].targetDeviceId || ''
      if (actionDeviceId !== removedId) {
        remainingActions.push(this.actions[index])
      }
    }
    this.actions = remainingActions
    if (this.deviceIndex >= this.devices.length) {
      this.deviceIndex = this.devices.length - 1
    }
    this.syncCurrentDevice()
    this.updateLearningSelection()
    this.managementMessage = '已删除 ' + removedName + ' 及其动作'
    this.sendWatchConfig('delete_device', this.managementMessage)
  },

  openActionConfig() {
    this.syncCurrentDevice()
    this.updateLearningSelection()
    this.updateBindingOverview()
    this.actionConfigMessage = '请选择要配置的设备指令'
    this.managementSubMessage = '先配置指令，再选择默认动作或自定义训练动作'
    this.showSection('actionConfig')
  },

  localAddAction() {
    this.openActionConfig()
  },

  addOpenAction() { this.openCommandBinding('开启', 'power_on') },
  addCloseAction() { this.openCommandBinding('关闭', 'power_off') },
  addIncreaseAction() { this.openCommandBinding('调高', 'value_up') },
  addDecreaseAction() { this.openCommandBinding('调低', 'value_down') },
  addCustomAction() { this.openCommandBinding('自定义', 'custom_command') },

  openCommandBinding(title, commandAction) {
    this.syncCurrentDevice()
    this.selectedCommandTitle = title + '指令'
    this.selectedCommandKey = commandAction
    this.selectedCommandAction = commandAction
    const existing = this.findBoundCommandAction(commandAction)
    if (existing) {
      this.trainingActionId = existing.id
      this.selectedTriggerName = existing.triggerName || existing.name || '已绑定动作'
      this.selectedTriggerCommand = existing.triggerCommand || existing.command || ''
    } else {
      this.selectedTriggerName = '未绑定'
      this.selectedTriggerCommand = ''
    }
    this.updateBindingOverview()
    this.actionConfigMessage = this.selectedCommandTitle + ' / 请选择触发动作'
    this.showSection('actionTrain')
  },

  bindTriggerSwingUp() { this.bindExistingTrigger('上摆', 'swing_up') },
  bindTriggerSwingDown() { this.bindExistingTrigger('下摆', 'swing_down') },
  bindTriggerRotateCw() { this.bindExistingTrigger('顺时针', 'rotate_cw') },
  bindTriggerRotateCcw() { this.bindExistingTrigger('逆时针', 'rotate_ccw') },

  bindExistingTrigger(triggerName, triggerCommand) {
    const conflict = this.findTriggerConflict(triggerCommand, this.selectedCommandAction)
    if (conflict) {
      this.actionConfigMessage = triggerName + ' 已用于「' + this.commandActionLabel(conflict.commandAction) + '」'
      this.bindingWarningText = '同一动作不能同时触发多个指令'
      this.managementMessage = this.actionConfigMessage
      return
    }
    const action = this.upsertCommandBinding(triggerName, triggerCommand, false)
    this.trainingActionId = action.id
    this.selectedTriggerName = triggerName
    this.selectedTriggerCommand = triggerCommand
    this.actionConfigMessage = this.selectedCommandTitle + ' 已绑定：' + triggerName
    this.managementMessage = this.actionConfigMessage
    this.sendWatchConfig('bind_command_action', this.actionConfigMessage)
  },

  findTriggerConflict(triggerCommand, commandAction) {
    for (let index = 0; index < this.actions.length; index++) {
      const action = this.actions[index]
      const deviceId = action.deviceId || action.targetDeviceId || ''
      const trigger = action.triggerCommand || action.command || ''
      if (deviceId === this.currentDeviceId && trigger === triggerCommand &&
        action.commandAction && action.commandAction !== commandAction) {
        return action
      }
    }
    return null
  },

  clearSelectedCommandBinding() {
    const existing = this.findBoundCommandAction(this.selectedCommandAction)
    if (!existing) {
      this.actionConfigMessage = this.selectedCommandTitle + ' 尚未绑定动作'
      return
    }
    const remaining = []
    for (let index = 0; index < this.actions.length; index++) {
      if (this.actions[index].id !== existing.id) {
        remaining.push(this.actions[index])
      }
    }
    this.actions = remaining
    this.trainingActionId = ''
    this.selectedTriggerName = '未绑定'
    this.selectedTriggerCommand = ''
    this.updateLearningSelection()
    this.updateBindingOverview()
    this.actionConfigMessage = this.selectedCommandTitle + ' 已解除绑定'
    this.managementMessage = this.actionConfigMessage
    this.sendWatchConfig('unbind_command_action', this.actionConfigMessage)
  },

  openCustomTriggerTraining() {
    const action = this.upsertCommandBinding('自定义动作', 'custom_train_' + this.selectedCommandKey, true)
    this.trainingActionId = action.id
    this.selectedTriggerName = '自定义动作'
    this.selectedTriggerCommand = action.command
    this.selectedActionFlowTitle = this.selectedCommandTitle + ' · 自定义动作'
    this.selectedActionFlowCommand = action.command
    this.updateLearningSelection()
    this.trainingHintText = '请在 PC 端输入第 1/10 组肌电 + IMU 数据'
    this.sendWatchConfig('start_custom_training', '开始训练：' + this.selectedActionFlowTitle)
    this.showSection('customTrain')
  },

  finishCustomTraining() {
    this.selectedTriggerName = '自定义动作'
    this.updateBindingOverview()
    this.actionConfigMessage = this.selectedCommandTitle + ' 已绑定自定义动作'
    this.managementMessage = this.actionConfigMessage
    this.managementSubMessage = '自定义动作可继续采集训练，也可同步到 PC'
    this.sendWatchConfig('finish_custom_training', this.actionConfigMessage)
    this.showSection('actionTrain')
  },

  finishActionBinding() {
    this.updateBindingOverview()
    this.actionConfigMessage = this.selectedCommandTitle + ' 绑定完成：' + this.selectedTriggerName
    this.managementMessage = this.actionConfigMessage
    this.managementSubMessage = '可继续配置其他指令，最后完成配置同步 PC'
    this.sendWatchConfig('finish_command_binding', this.actionConfigMessage)
    this.showSection('actionConfig')
  },

  findBoundCommandAction(commandAction) {
    for (let index = 0; index < this.actions.length; index++) {
      const action = this.actions[index]
      const deviceId = action.deviceId || action.targetDeviceId || ''
      if (deviceId === this.currentDeviceId && action.commandAction === commandAction) {
        return action
      }
    }
    return null
  },

  commandActionLabel(commandAction) {
    if (commandAction === 'power_on') {
      return '开启'
    }
    if (commandAction === 'power_off') {
      return '关闭'
    }
    if (commandAction === 'value_up') {
      return '调高'
    }
    if (commandAction === 'value_down') {
      return '调低'
    }
    if (commandAction === 'custom_command') {
      return '自定义'
    }
    return commandAction || '指令'
  },

  bindingTriggerText(commandAction) {
    const action = this.findBoundCommandAction(commandAction)
    if (!action) {
      return '未绑定'
    }
    return action.triggerName || action.triggerCommand || action.command || '已绑定'
  },

  updateBindingOverview() {
    const commandActions = ['power_on', 'power_off', 'value_up', 'value_down']
    let boundCount = 0
    const used = []
    let conflictText = ''
    for (let index = 0; index < commandActions.length; index++) {
      const action = this.findBoundCommandAction(commandActions[index])
      if (action) {
        boundCount += 1
        const trigger = action.triggerCommand || action.command || ''
        if (trigger) {
          for (let usedIndex = 0; usedIndex < used.length; usedIndex++) {
            if (used[usedIndex] === trigger) {
              conflictText = '提示：同一动作绑定多个指令'
            }
          }
          used.push(trigger)
        }
      }
    }
    this.bindingOpenText = this.bindingTriggerText('power_on')
    this.bindingCloseText = this.bindingTriggerText('power_off')
    this.bindingUpText = this.bindingTriggerText('value_up')
    this.bindingDownText = this.bindingTriggerText('value_down')
    const custom = this.findBoundCommandAction('custom_command')
    this.bindingCustomText = custom ? this.bindingTriggerText('custom_command') : '可添加训练动作'
    this.bindingProgressText = boundCount + '/4 指令已绑定'
    if (conflictText) {
      this.bindingWarningText = conflictText
    } else if (boundCount >= 4) {
      this.bindingWarningText = '默认映射完整，可同步 PC'
    } else {
      this.bindingWarningText = '未绑定指令可继续配置'
    }
  },

  upsertCommandBinding(triggerName, triggerCommand, custom) {
    let action = this.findBoundCommandAction(this.selectedCommandAction)
    const actionId = this.currentDeviceId + '_' + this.selectedCommandAction
    const actionName = this.currentDeviceName + this.selectedCommandTitle
    if (!action) {
      action = {
        id: actionId,
        name: actionName,
        command: triggerCommand,
        commandAction: this.selectedCommandAction,
        triggerName: triggerName,
        triggerCommand: triggerCommand,
        isCustomTrigger: custom,
        description: 'command-action binding',
        deviceId: this.currentDeviceId,
        targetDeviceId: this.currentDeviceId,
        deviceName: this.currentDeviceName
      }
      this.actions.push(action)
    } else {
      action.name = actionName
      action.command = triggerCommand
      action.commandAction = this.selectedCommandAction
      action.triggerName = triggerName
      action.triggerCommand = triggerCommand
      action.isCustomTrigger = custom
      action.deviceId = this.currentDeviceId
      action.targetDeviceId = this.currentDeviceId
      action.deviceName = this.currentDeviceName
    }
    this.updateLearningSelection()
    this.updateCurrentAction()
    this.updateBindingOverview()
    return action
  },

  addActionByCommand(suffix, command, silent) {
    for (let actionIndex = 0; actionIndex < this.actions.length; actionIndex++) {
      const action = this.actions[actionIndex]
      const deviceId = action.deviceId || action.targetDeviceId || ''
      if (deviceId === this.currentDeviceId && action.command === command) {
        this.trainingActionId = action.id
        this.updateLearningSelection()
        this.actionConfigMessage = '已存在：' + (action.name || command)
        this.managementMessage = this.actionConfigMessage
        return action
      }
    }
    const actionId = this.currentDeviceId + '_' + command
    const actionName = this.currentDeviceName + suffix
    this.actions.push({
      id: actionId,
      name: actionName,
      command: command,
      description: 'AIoT watch action config',
      deviceId: this.currentDeviceId,
      targetDeviceId: this.currentDeviceId,
      deviceName: this.currentDeviceName
    })
    this.trainingActionId = actionId
    this.updateLearningSelection()
    this.updateCurrentAction()
    this.actionConfigMessage = '已添加：' + actionName
    this.managementMessage = this.actionConfigMessage
    if (!silent) {
      this.sendWatchConfig('add_action', this.actionConfigMessage)
    }
    return this.actions[this.actions.length - 1]
  },

  finishActionConfig() {
    this.syncCurrentDevice()
    this.updateLearningSelection()
    this.managementMessage = this.currentDeviceName + ' 动作配置完成'
    this.managementSubMessage = this.currentActionCountText + ' / 可进入 AI 学习采集样本'
    this.actionConfigMessage = this.currentActionCountText + ' / 已完成配置，可继续添加或删除动作'
    this.sendWatchConfig('finish_action_config', this.managementMessage)
    this.showSection('manage')
  },

  finishActionTraining() {
    this.syncCurrentDevice()
    this.updateLearningSelection()
    this.actionConfigMessage = this.trainingActionName + ' 已绑定，可继续选择其他动作'
    this.managementMessage = this.actionConfigMessage
    this.managementSubMessage = '如已采满 10 组，可训练模型后再完成配置'
    this.sendWatchConfig('finish_action_training', this.actionConfigMessage)
    this.showSection('actionConfig')
  },

  localDeleteAction() {
    const currentActions = this.getCurrentActions()
    if (currentActions.length < 1) {
      this.managementMessage = '当前设备没有可删除动作'
      return
    }
    let removedAction = currentActions[currentActions.length - 1]
    for (let index = 0; index < currentActions.length; index++) {
      if (currentActions[index].id === this.trainingActionId) {
        removedAction = currentActions[index]
      }
    }
    const remaining = []
    for (let index = 0; index < this.actions.length; index++) {
      if (this.actions[index].id !== removedAction.id) {
        remaining.push(this.actions[index])
      }
    }
    this.actions = remaining
    this.trainingActionId = ''
    this.updateLearningSelection()
    this.updateBindingOverview()
    this.managementMessage = '已删除动作：' + (removedAction.name || removedAction.command)
    this.sendWatchConfig('delete_action', this.managementMessage)
  },

  sendLocalConfig() {
    this.configVersion += 1
    this.managementMessage = '正在同步完整配置 #' + this.configVersion
    this.managementSubMessage = '已点击同步，等待 PC 回执...'
    this.sendWatchConfig('sync_config', '完整配置已提交 #' + this.configVersion)
  },

  sendWatchConfig(operation, label) {
    if (operation !== 'sync_config') {
      this.configVersion += 1
    }
    const payload = {
      type: 'watch_input_command',
      origin: 'watch',
      inputSource: 'AIoT本地管理',
      sourceText: operation,
      label: label,
      operation: operation,
      targetDeviceId: this.currentDeviceId,
      targetDeviceName: this.currentDeviceName,
      devices: this.devices,
      actions: this.actions,
      settings: {
        safetyGuardEnabled: this.safetyGuardEnabled,
        safetyThreshold: this.safetyThreshold,
        operationMode: this.operationMode
      },
      configVersion: this.configVersion
    }
    fetch.fetch({
      url: this.pcUrl,
      method: 'POST',
      responseType: 'json',
      header: { 'Content-Type': 'application/json' },
      data: JSON.stringify(payload),
      success: () => {
        this.managementMessage = label + ' · 已同步 PC'
        this.managementSubMessage = 'PC 已接收：' + operation + ' / v' + this.configVersion
        this.connectionBadge = 'ONLINE'
      },
      fail: () => {
        this.managementMessage = label + ' · 本地已保存，PC 待同步'
        this.managementSubMessage = '请确认上位机 8787 服务已启动'
        this.connectionBadge = 'OFFLINE'
      }
    })
  },

  openLearning() {
    this.showSection('learning')
    this.updateLearningSelection()
  },

  openCopilot() {
    this.showSection('copilot')
    this.copilotHintText = this.connectionBadge === 'ONLINE' ? '双端链路在线 · 可开始闭环演示' : '等待 PC 上位机连接'
  },

  runContestDemo() {
    this.copilotHintText = '已请求 PC 启动 AI 闭环演示'
    this.decisionExplainText = '演示将依次展示空间校准、目标锁定、特征融合、安全判定和设备执行。'
    this.postToPc({
      command: 'closed_loop_demo',
      label: 'AI 决策闭环演示',
      inputSource: 'AIoT 决策舱',
      confidence: 96
    }, 'AI 闭环演示已提交')
  },

  openDevices() {
    this.showSection('devices')
    this.syncCurrentDevice()
  },

  openManage() {
    this.showSection('manage')
    this.syncCurrentDevice()
    this.actionConfigMessage = this.currentActionCountText + ' / 点击配置动作继续绑定'
    this.managementMessage = '当前：' + this.currentDeviceName
    this.managementSubMessage = '添加设备、配置动作后会自动同步 PC'
  },

  openStatus() {
    this.showSection('status')
  },

  openAbout() {
    this.showSection('about')
  },

  showSection(section) {
    this.homeVisible = section === 'home'
    this.copilotVisible = section === 'copilot'
    this.learningVisible = section === 'learning'
    this.devicesVisible = section === 'devices'
    this.manageVisible = section === 'manage'
    this.actionConfigVisible = section === 'actionConfig'
    this.actionTrainVisible = section === 'actionTrain'
    this.customTrainVisible = section === 'customTrain'
    this.manualInputVisible = section === 'manual'
    this.statusVisible = section === 'status'
    this.aboutVisible = section === 'about'
    if (section === 'manual') {
      this.focusManualInput()
    } else {
      this.stopManualCursorBlink()
    }
  },

  goHome() {
    this.showSection('home')
  },

  handleSwipe() {
    if (this.customTrainVisible) {
      this.showSection('actionTrain')
      return true
    }
    if (this.actionTrainVisible) {
      this.openActionConfig()
      return true
    }
    if (this.actionConfigVisible) {
      this.openManage()
      return true
    }
    if (this.manualInputVisible) {
      this.openManage()
      return true
    }
    if (this.manageVisible) {
      this.openDevices()
      return true
    }
    if (this.copilotVisible) {
      this.goHome()
      return true
    }
    if (!this.homeVisible) {
      this.goHome()
      return true
    }
    return false
  },

  onBackPress() {
    if (this.customTrainVisible) {
      this.showSection('actionTrain')
      return true
    }
    if (this.actionTrainVisible) {
      this.openActionConfig()
      return true
    }
    if (this.actionConfigVisible) {
      this.openManage()
      return true
    }
    if (this.manualInputVisible) {
      this.openManage()
      return true
    }
    if (this.manageVisible) {
      this.openDevices()
      return true
    }
    if (this.copilotVisible) {
      this.goHome()
      return true
    }
    if (!this.homeVisible) {
      this.goHome()
      return true
    }
    return false
  },

  clamp(value, min, max) {
    if (value < min) {
      return min
    }
    if (value > max) {
      return max
    }
    return value
  }
}
</script>

